# Docker PostgreSQL exposed on the host.
# If FastAPI also runs inside Docker, replace localhost with the compose service name.
TODOAPP_DATABASE_URL=postgresql+psycopg://todoapp:change-me@localhost:5432/todoapp

# The frontend still talks to FastAPI through Vite during local development.
FRONTEND_URL=http://localhost:5173
TODOAPP_CORS_ORIGINS=http://localhost:5173
